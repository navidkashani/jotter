---
/**
 * The page frame: head, header, sidebar, main.
 *
 * Two scripts live here. The theme island is `is:inline` in `<head>` on purpose
 * — it has to run before first paint, or a reader who chose dark gets a white
 * flash on every navigation — and the drawer enhancement is a bundled body
 * script at the end of `<body>`. Everything on the page works with scripting
 * off; neither script is load-bearing.
 *
 * Both are written as plain JavaScript, not as a `{`…`}` expression holding a
 * template literal. A `<script>` element is raw text, so Astro emits an
 * expression there verbatim — braces, backticks and all — and the browser gets
 * a syntax error. `ThemeToggle.astro` has always had the right shape.
 */
import { Font } from 'astro:assets'

import { config } from '../lib/site.js'
import { t } from '../i18n/index.js'
import Header from '../components/Header.astro'
import Sidebar from '../components/Sidebar.astro'
import Analytics from '../components/Analytics.astro'

import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/prose.css'
import '../styles/print.css'
import '../styles/custom.css'

interface Props {
  title?: string
  description?: string
  /** Slug of the current note, so the nav can mark it. */
  current?: string
}

const { title, description, current } = Astro.props

/**
 * Search belongs on every page, and this is the only layout all of them share
 * — `Note.astro` would leave the tag pages, `/notes` and the 404 without it.
 *
 * The flag arrives as a literal from `astro.config.ts` rather than off
 * `config`, and the import is dynamic, so that with search off Rollup can drop
 * `Search.astro` and its script out of the build entirely. See the note beside
 * `JOTTER_SEARCH` there.
 */
const showSearch: boolean = import.meta.env.JOTTER_SEARCH
const Search = showSearch ? (await import('../components/Search.astro')).default : null

const pageTitle = title ? `${title} — ${config.title}` : config.title
const pageDescription = description || config.description
const canonical = config.url ? new URL(Astro.url.pathname, config.url).href : undefined
---

<!doctype html>
<html lang={config.locale} dir={config.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>

    {pageDescription && <meta name="description" content={pageDescription} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {config.noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? config.title} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={config.title} />
    <meta name="twitter:card" content="summary" />

    <Font cssVariable="--font-sans" preload />
    <Font cssVariable="--font-mono" />

    {
      /**
       * Set before first paint, so there is no flash. Kept as a string rather
       * than a component so nothing schedules it after the stylesheet.
       * `color-scheme` is set alongside so form controls and scrollbars match.
       */
      config.features.themeToggle && (
        <script is:inline>
          (()=>{try{const s=localStorage.getItem('jotter-theme');const d=matchMedia('(prefers-color-scheme:dark)').matches;const t=s==='dark'||s==='light'?s:(d?'dark':'light');document.documentElement.dataset.theme=t;document.documentElement.style.colorScheme=t}catch(e){}})()
        </script>
      )
    }

    {
      /**
       * Last in `<head>`, and one rule for all six rather than each vendor's
       * own. Every tag is `defer` or `async`, so none of them blocks paint
       * wherever it sits; Cloudflare documents body-end and works here just as
       * well. The component renders nothing at all unless a provider is
       * configured, and nothing during `astro dev` either way.
       */
    }
    <Analytics />
  </head>

  <body>
    <a class="skip-link" href="#content">{t('site.skipToContent')}</a>

    {
      /**
       * The drawer toggle is the checkbox itself, not a label for one. A label
       * is not in the tab order, so a keyboard user with scripting off could
       * never reach it; a styled checkbox is focusable, operable with Space,
       * and announced with its own name. The script below only adds
       * Esc-to-close and `inert` on top of behaviour that already works.
       */
      config.nav !== 'none' && (
        <input
          type="checkbox"
          id="jotter-drawer"
          class="drawer-checkbox"
          data-drawer-toggle
          aria-label={t('site.openNavigation')}
          aria-controls="sidebar"
        />
      )
    }

    <div class="page" data-nav={config.nav}>
      <Header />
      {config.nav !== 'none' && <Sidebar current={current} />}
      <main class="main" id="content">
        <slot />
      </main>
    </div>

    {
      /**
       * Enhancement only: the drawer already opens, closes and is keyboard
       * operable through the checkbox. This adds Esc-to-close, closing on
       * navigation, and `inert` on the page behind it so focus cannot wander
       * out of an open drawer into the article underneath.
       */
      config.nav !== 'none' && (
        <script>
          const toggle = document.querySelector<HTMLInputElement>('#jotter-drawer')
          const sidebar = document.getElementById('sidebar')
          const main = document.querySelector<HTMLElement>('.main')

          if (toggle && sidebar && main) {
            const mobile = window.matchMedia('(max-width: 800px)')
            const sync = () => {
              const open = toggle.checked && mobile.matches
              main.inert = open
              if (open) sidebar.querySelector<HTMLElement>('a, button, summary')?.focus()
            }
            toggle.addEventListener('change', sync)
            mobile.addEventListener('change', sync)
            document.addEventListener('keydown', (event) => {
              if (event.key === 'Escape' && toggle.checked) {
                toggle.checked = false
                sync()
                toggle.focus()
              }
            })
            // A link inside the drawer navigates; leaving it open over the new
            // page would hide what the reader just asked for.
            sidebar.addEventListener('click', (event) => {
              if (event.target instanceof Element && event.target.closest('a')) {
                toggle.checked = false
                sync()
              }
            })
          }
        </script>
      )
    }

    {Search && <Search />}
  </body>
</html>
