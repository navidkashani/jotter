---
/**
 * A note, with — or without — its rail.
 *
 * The DOM order is head, outline, body, rail, and that is the reading order at
 * every width and in both layouts. `column` stacks it: the outline is a
 * collapsible `<details>` above the prose and backlinks are cards below it.
 * `panels` places the outline and the rail into a second column with grid, and
 * folds back to the stack below 1100px. Nothing is duplicated, nothing is
 * hidden; the same markup is simply placed differently.
 *
 * The rail is genuinely absent in `column` rather than merely narrow: a 660px
 * reading column with nothing beside it is the point of that layout, and
 * backlinks read better as cards under the prose than as a list off to one
 * side. Which form the backlinks take is the only thing the layout tells them.
 */
import type { VaultNote } from '../lib/vault.js'
import type { GraphLink, Neighbourhood } from '../lib/graph.js'
import { config } from '../lib/site.js'
import Base from './Base.astro'
import Toc from '../components/Toc.astro'
import type { Heading } from '../lib/headings.js'
import Backlinks from '../components/Backlinks.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Frontmatter from '../components/Frontmatter.astro'
import LocalGraph from '../components/LocalGraph.astro'
import TagList from '../components/TagList.astro'
import PrevNext from '../components/PrevNext.astro'
import { t } from '../i18n/index.js'

interface Props {
  note: VaultNote
  headings: Heading[]
  backlinks: GraphLink[]
  neighbourhood: Neighbourhood
  previous?: VaultNote
  next?: VaultNote
}

const { note, headings, backlinks, neighbourhood, previous, next } = Astro.props

const description =
  typeof note.frontmatter.description === 'string' ? note.frontmatter.description : note.excerpt
---

<Base title={note.title} description={description} current={note.slug}>
  <article class="note-layout" data-layout={config.layout}>
    <header class="note-head">
      <Breadcrumb note={note} />
      <h1 class="note-title">{note.title}</h1>
      <Frontmatter note={note} />
      {config.features.tags && <TagList tags={note.tags} />}
    </header>

    {config.features.toc && <Toc headings={headings} />}

    <div class="note-body prose">
      <slot />
      <PrevNext previous={previous} next={next} />
    </div>

    {
      (config.features.backlinks || config.features.graph) && (
        <aside class="note-rail" aria-label={t('note.context')}>
          {config.features.graph && (
            <LocalGraph neighbourhood={neighbourhood} current={note.slug} />
          )}
          {config.features.backlinks && <Backlinks links={backlinks} />}
        </aside>
      )
    }
  </article>
</Base>
