---
/**
 * A note, with (or without) its rail.
 *
 * Two shapes, and the DOM differs between them, which it did not use to, and
 * the reason is worth recording.
 *
 * `column` is head, outline, body, rail: the outline is a collapsible
 * `<details>` above the prose and backlinks are cards below it, which is both
 * the visual order and the reading order.
 *
 * `panels` is head, aside(outline + rail), body. The outline and the rail are
 * wrapped because as separate grid items they broke twice: the outline sized
 * the grid row it shared with the title block, pushing the prose down by up to
 * 151px, and two sticky siblings in one column pinned to the same offset and
 * overprinted each other on scroll. See the panels block in `base.css`.
 *
 * The cost is that in `panels` the graph and backlinks are read before the
 * prose rather than after it. That is the trade the wrapper forces, and it is
 * softened by the rail being a complementary landmark (skippable in one
 * keystroke) with `<main>` and the skip link already in place.
 *
 * `config.layout` is build-time, so exactly one of these branches is ever
 * emitted. Nothing is duplicated in the output, nothing is hidden with CSS.
 *
 * The rail is genuinely absent in `column` rather than merely narrow: a 660px
 * reading column with nothing beside it is the point of that layout, and
 * backlinks read better as cards under the prose than as a list off to one
 * side. Which form the backlinks take is the only thing the layout tells them.
 */
import type { VaultNote } from '../lib/vault.js'
import type { GraphLink, Neighbourhood } from '../lib/graph.js'
import { config, vault } from '../lib/site.js'
import { textDir } from '../lib/bidi.js'
import Base from './Base.astro'
import Toc from '../components/Toc.astro'
import type { Heading } from '../lib/headings.js'
import Backlinks from '../components/Backlinks.astro'
import Breadcrumb from '../components/Breadcrumb.astro'
import Frontmatter from '../components/Frontmatter.astro'
import TagList from '../components/TagList.astro'
import PrevNext from '../components/PrevNext.astro'
import { frontmatterImage, resolveSocialImage, socialImageUrl } from '../lib/social.js'
import { t } from '../i18n/index.js'

interface Props {
  note: VaultNote
  headings: Heading[]
  backlinks: GraphLink[]
  neighbourhood: Neighbourhood
  previous?: VaultNote
  next?: VaultNote
}

const { note, headings, backlinks, neighbourhood, previous, next } = Astro.props

const description =
  typeof note.frontmatter.description === 'string' ? note.frontmatter.description : note.excerpt

/**
 * The note's own card image, beside the description it already reads off
 * frontmatter: this is the layout that can see frontmatter at all, and the
 * existing precedent for a declared key reaching `<head>` through a prop.
 *
 * Resolved against the vault the way an embed is, so `attachments/x.png`, a
 * bare `x.png` and `./x.png` all find the same file. A value that resolves to
 * nothing (or to a format no unfurler draws) is `undefined` here and the page
 * falls back to the site-wide default; the scan has already warned about it by
 * name, which is where a build warning can actually be read.
 */
const image = socialImageUrl(
  resolveSocialImage(frontmatterImage(note.frontmatter)?.value, note.path, vault),
  config.url,
)

/**
 * `panels` only. The graph is a picture of where you are, and it needs a
 * column beside the prose to be one; dropped into the `column` stack it
 * becomes a square of dots between the article and its backlinks, which is
 * where the mockup never put it. `features.graph` is honoured, not overridden:
 * it simply has nowhere to render in the layout that has no rail.
 *
 * The flag arrives as a literal from `astro.config.ts` rather than off
 * `config`, and the import is dynamic, so that with the graph off Rollup can
 * drop `LocalGraph.astro` and its 18 KB of `d3-force` out of the build
 * entirely. See the note beside `JOTTER_GRAPH` there.
 */
const showGraph: boolean = import.meta.env.JOTTER_GRAPH
const LocalGraph = showGraph ? (await import('../components/LocalGraph.astro')).default : null

/**
 * Hover previews, gated the same way and for the same reason. This layout is
 * the right place for it: both `[...slug].astro` and `index.astro` wrap their
 * prose in it, and the anchors carrying the excerpts are inside that prose.
 */
const showHoverPreview: boolean = import.meta.env.JOTTER_HOVER_PREVIEW
const HoverPreview = showHoverPreview
  ? (await import('../components/HoverPreview.astro')).default
  : null

/**
 * Click-to-play, gated the same way and for the same reason. With embeds off
 * there is no facade in the markup for this script to upgrade, so shipping it
 * would be bytes doing nothing on every note page.
 */
const showEmbeds: boolean = import.meta.env.JOTTER_EMBEDS
const Embeds = showEmbeds ? (await import('../components/Embeds.astro')).default : null

/**
 * What Pagefind indexes, and (the part worth naming) what it therefore does
 * *not*. `data-pagefind-body` is **site-wide sticky**: once it appears on any
 * page, every page without it is dropped. So putting it here quietly decides
 * that the tag pages, the folder listings, `/notes` and the 404 are all out of
 * the index. That is the right answer rather than a side effect: a listing's
 * content is note titles and excerpts that are already indexed on the notes
 * themselves, so indexing it would return the same note twice, once under a
 * URL that is not its own.
 *
 * On the `<article>` rather than on `.note-body`, so the title, the
 * frontmatter and the tags are inside it with the prose. One element down and
 * the `<h1>` falls outside, and Pagefind loses every result's title.
 *
 * `.note-aside` and `.note-rail` are cut back out. All of it is navigation
 * whose text belongs to *other* notes: the outline aside, every note would
 * otherwise match on each of its neighbours' titles. `<PrevNext>` carries the
 * same attribute for the same reason.
 *
 * A plain `config` test is enough here: these are attributes, not a script, so
 * there is no bundle to drop. Off, they are absent rather than ignored.
 */
const indexed = config.features.search ? '' : undefined

/** Which of the two DOM shapes above to emit. Resolved at build. */
const panels = config.layout === 'panels'
const hasToc = config.features.toc
const hasRail = config.features.backlinks || showGraph
---

<Base title={note.title} description={description} image={image} current={note.slug}>
  <article class="note-layout" data-layout={config.layout} data-pagefind-body={indexed}>
    <header class="note-head">
      <Breadcrumb note={note} />
      <h1 class="note-title" dir={textDir(note.title, config.dir)}>{note.title}</h1>
      {config.features.metadata && <Frontmatter note={note} />}
      {config.features.tags && <TagList tags={note.tags} />}
    </header>

    {
      panels && (hasToc || hasRail) && (
        <div class="note-aside" data-pagefind-ignore={indexed}>
          {hasToc && <Toc headings={headings} />}
          {hasRail && (
            <aside class="note-rail" aria-label={t('note.context')} data-pagefind-ignore={indexed}>
              {LocalGraph && <LocalGraph neighbourhood={neighbourhood} current={note.slug} />}
              {config.features.backlinks && <Backlinks links={backlinks} />}
            </aside>
          )}
        </div>
      )
    }

    {!panels && hasToc && <Toc headings={headings} />}

    <div class="note-body prose">
      <slot />
      {config.features.prevNext && <PrevNext previous={previous} next={next} />}
    </div>

    {
      !panels && hasRail && (
        <aside class="note-rail" aria-label={t('note.context')} data-pagefind-ignore={indexed}>
          {LocalGraph && <LocalGraph neighbourhood={neighbourhood} current={note.slug} />}
          {config.features.backlinks && <Backlinks links={backlinks} />}
        </aside>
      )
    }

    {HoverPreview && <HoverPreview />}
    {Embeds && <Embeds />}
  </article>
</Base>
