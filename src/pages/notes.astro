---
/**
 * Every published note, newest first.
 *
 * A real top-level folder called `notes` would claim this URL through the
 * catch-all. This page wins, and the build says so rather than one of them
 * silently disappearing.
 */
import { byUpdated, allFolders } from '../lib/site.js'
import Base from '../layouts/Base.astro'
import NoteList from '../components/NoteList.astro'
import { t } from '../i18n/index.js'

if (allFolders.some((folder) => folder.slug === 'notes')) {
  console.warn(
    '[jotter] A vault folder also slugifies to "notes". /notes is the all-notes ' +
      'index; the folder is reachable from the sidebar tree but has no index page.',
  )
}
---

<Base title={t('index.allNotes')}>
  <div class="stack-l notes-page">
    <header>
      <h1 class="index-title">{t('index.allNotes')}</h1>
      <p class="meta">{t('index.noteCount', { count: byUpdated.length })}</p>
    </header>
    <NoteList notes={byUpdated} variant="rows" />
  </div>
</Base>

<style>
  .notes-page {
    max-inline-size: var(--column-width);
    margin-inline: auto;
  }
</style>
