---
/**
 * Notes and folder indexes, from one catch-all.
 *
 * Folders get pages so that a tree parent is a link and not just a toggle. A
 * note and a folder can slugify to the same path, and when they do the note
 * wins and the build says so: silently dropping either would be worse than
 * either choice.
 */
import { getCollection, render } from 'astro:content'

import { notes, allFolders, tree, backlinksFor, graph } from '../lib/site.js'
import { neighbourhood } from '../lib/graph.js'
import { noteHref } from '../lib/href.js'
import type { VaultNote } from '../lib/vault.js'
import type { TreeEntry } from '../lib/tree.js'
import Note from '../layouts/Note.astro'
import Base from '../layouts/Base.astro'
import NoteList from '../components/NoteList.astro'
import { t } from '../i18n/index.js'

export async function getStaticPaths() {
  const { notes, allFolders } = await import('../lib/site.js')

  const claimed = new Set<string>()
  const paths: {
    params: { slug: string }
    props: { kind: 'note'; path: string } | { kind: 'folder'; path: string }
  }[] = []

  for (const note of notes) {
    // `/` is rendered by index.astro; emitting it here too would collide.
    // One clause, because `index` is how jotter spells "at the root": the note
    // `homepage:` names is given that slug by the scan, so there is nothing
    // else to skip and nothing left linking to a slug with no page behind it.
    if (note.slug === 'index') continue
    claimed.add(note.slug)
    paths.push({ params: { slug: note.slug }, props: { kind: 'note', path: note.path } })
  }

  for (const folder of allFolders) {
    if (claimed.has(folder.slug)) {
      console.warn(
        `[jotter] "${folder.slug}" is claimed by both a note and the folder ` +
          `"${folder.path}". The note wins; the folder has no index page.`,
      )
      continue
    }
    paths.push({ params: { slug: folder.slug }, props: { kind: 'folder', path: folder.path } })
  }

  return paths
}

const { kind, path } = Astro.props

/* ---- A note ------------------------------------------------------------ */

type Rendered = Awaited<ReturnType<typeof render>>

let rendered: Rendered | undefined
let note: VaultNote | undefined

if (kind === 'note') {
  note = notes.find((n) => n.path === path)
  const entries = await getCollection('notes')
  const entry = entries.find((e) => e.id === path)
  if (!entry || !note) throw new Error(`[jotter] No collection entry for ${path}`)
  rendered = await render(entry)
}

const Content = rendered?.Content

const index = note ? notes.findIndex((n) => n.slug === note!.slug) : -1
const previous = index > 0 ? notes[index - 1] : undefined
const next = index >= 0 && index < notes.length - 1 ? notes[index + 1] : undefined

/* ---- A folder ---------------------------------------------------------- */

const folder = kind === 'folder' ? allFolders.find((f) => f.path === path) : undefined

const findEntries = (entries: TreeEntry[], target: string): TreeEntry[] => {
  for (const entry of entries) {
    if (entry.kind !== 'folder') continue
    if (entry.path === target) return entry.children
    const found = findEntries(entry.children, target)
    if (found.length) return found
  }
  return []
}

const children = folder ? findEntries(tree, folder.path) : []
const childNotes = children
  .filter((c): c is Extract<TreeEntry, { kind: 'note' }> => c.kind === 'note')
  .map((c) => notes.find((n) => n.slug === c.slug))
  .filter((n): n is VaultNote => Boolean(n))
const childFolders = children.filter((c): c is Extract<TreeEntry, { kind: 'folder' }> => c.kind === 'folder')
---

{
  kind === 'note' && note && Content ? (
    <Note
      note={note}
      headings={rendered?.headings ?? []}
      backlinks={backlinksFor(note.slug)}
      neighbourhood={neighbourhood(graph, note.slug, 1)}
      previous={previous}
      next={next}
    >
      <Content />
    </Note>
  ) : (
    <Base title={folder?.name} current={folder?.slug}>
      <div class="stack-l">
        <header>
          <h1 class="index-title">{folder?.name}</h1>
          <p class="meta">{t('index.noteCount', { count: folder?.count ?? 0 })}</p>
        </header>

        {childFolders.length > 0 && (
          <section class="stack">
            <h2 class="label">{t('index.subfolders')}</h2>
            <div class="note-grid">
              {childFolders.map((child) => (
                <a class="note-card" href={noteHref(child.slug)}>
                  <span class="note-card-title">{child.name}</span>
                  <span class="meta">{t('index.noteCount', { count: child.count })}</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {childNotes.length > 0 && (
          <section class="stack">
            <h2 class="label">{t('index.inFolder')}</h2>
            <NoteList notes={childNotes} variant="rows" />
          </section>
        )}
      </div>
    </Base>
  )
}
