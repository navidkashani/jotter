---
/**
 * The analytics tag, if the config asked for one.
 *
 * Renders no user-visible text, so nothing here goes through `t()` — the
 * absence of an `src/i18n/` key for this component is a fact about the feature,
 * not an omission.
 *
 * `is:inline` is required. Astro processes and hoists a bare external
 * `<script src>`, which would take the tag out of the markup entirely; the
 * directive is what makes it stay put. Attribute *expressions* are still
 * evaluated on an inline script — only a script's **body** is left
 * unprocessed — which is why the spread below works and why GA4's init block
 * uses `define:vars` rather than an expression. See the note at the top of
 * `Base.astro` for what happens when a `{…}` lands in a script body.
 *
 * No `JOTTER_*` literal is needed here, and that is worth stating so it does
 * not read as an oversight. The `vite.define` trap documented in
 * `astro.config.ts` exists because a component's *bundled* `<script>` ships
 * whenever the component is imported, conditional or not. Every tag this
 * component emits is `is:inline`, so there is no chunk for Rollup to drop and a
 * plain config test is sufficient. The day this file gains a bundled script,
 * that stops being true and it needs a literal like the other three.
 */
import { config } from '../lib/site.js'
import { analyticsTag } from '../lib/analytics.js'

/**
 * Production only. Without this gate every local reload during `astro dev`
 * would be a real pageview against real production stats — the bug Quartz
 * ships, which has no dev guard anywhere. Plausible and Umami discard localhost
 * by default; GA4, Fathom and GoatCounter do not, and a small garden's numbers
 * are exactly the kind a week of local editing ruins.
 *
 * `astro preview` serves a genuine production build, so that is where you check
 * your own setup.
 */
const tag = import.meta.env.PROD ? analyticsTag(config.analytics) : undefined

/**
 * The marker is how `scripts/verify-build.mjs` tells jotter's own tag from any
 * other external script that found its way into `dist/` — the same idiom as
 * `data-search` and `data-preview`. Every vendor here reads only its own
 * `data-` attribute and ignores the rest, so it is inert; it also makes
 * view-source say which vendor is loaded and that jotter put it there.
 */
const gaId = tag?.measurementId
---

{
  tag && (
    <script
      is:inline
      src={tag.src}
      async={tag.async}
      defer={!tag.async}
      data-jotter-analytics={config.analytics.provider}
      {...tag.attrs}
    />
  )
}

{
  /**
   * GA4 is the one provider whose snippet is two tags. `define:vars` prepends a
   * real `const` declaration and implies `is:inline`; interpolating the id into
   * the body instead would emit the braces verbatim, because a script body is
   * raw text.
   *
   * The one deviation from Google's published snippet is `window.gtag =`, and
   * it exists to keep that snippet's behaviour rather than depart from it:
   * `define:vars` wraps the body in an IIFE, so a bare `function gtag()` would
   * be scoped to it and `gtag('event', …)` from anywhere else on the page would
   * find nothing. Google's version is global because it is not wrapped. This
   * puts it back.
   */
  gaId && (
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || []
      window.gtag = function gtag() {
        window.dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', gaId)
    </script>
  )
}
