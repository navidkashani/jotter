---
/**
 * The note's own header block, shown as one.
 *
 * A vault file opens with a fenced YAML header, and a published note should
 * look like it still has one: mono, boxed, keys aligned in a column. That reads
 * as "this is the file's metadata" in a way a comma-separated byline never did.
 *
 * The keys are an **allow-list**, not a deny-list. Frontmatter is whatever its
 * owner typed: drafting notes to themselves, private URLs, a `publish: false`
 * they forgot to remove, so anything unrecognised stays off the page rather
 * than leaking by default.
 *
 * Created and updated answer different questions in a garden (when a thought
 * started, and whether it is still being tended), so both are shown, updated
 * only when it differs.
 *
 * **A date is shown only when it is a real one.** `resolveDates` falls back to
 * the file's mtime so that "recently updated" has something to sort by, and an
 * mtime is not a claim about a note: it is when this machine last wrote the
 * file. On a build from an Open Publish snapshot that is the second the vault
 * was fetched, which is how every page of a 96-note site came to read
 * `Created Sep 2, 2026`. `NoteDates.known` is which branch answered, and a row
 * whose date was guessed is simply absent.
 *
 * The whole block is behind `features.metadata`, off by default. This component
 * therefore has to survive having nothing at all to render.
 */
import type { VaultNote } from '../lib/vault.js'
import { config } from '../lib/site.js'
import { DISPLAYED_FIELDS } from '../lib/frontmatter.js'
import { formatDate, isoDate, t } from '../i18n/index.js'

interface Props {
  note: VaultNote
}

const { note } = Astro.props

const scalar = (value: unknown): string | undefined => {
  if (value instanceof Date) return Number.isNaN(value.getTime()) ? undefined : formatDate(value)
  if (typeof value === 'string') return value.trim() || undefined
  if (typeof value === 'number' || typeof value === 'boolean') return String(value)
  return undefined
}

/** Scalars and lists of scalars. Nested objects have no honest one-line form. */
const format = (value: unknown): string | undefined => {
  if (!Array.isArray(value)) return scalar(value)
  const parts = value.map(scalar).filter((part) => part !== undefined)
  return parts.length > 0 ? parts.join(', ') : undefined
}

const sameDay = isoDate(note.dates.created) === isoDate(note.dates.updated)
const { known } = note.dates

const rows: { key: string; label: string; value: string; datetime?: string }[] = [
  ...(known.created
    ? [
        {
          key: 'created',
          label: t('note.created'),
          value: formatDate(note.dates.created),
          datetime: isoDate(note.dates.created),
        },
      ]
    : []),
  ...(known.updated && !sameDay
    ? [
        {
          key: 'updated',
          label: t('note.updated'),
          value: formatDate(note.dates.updated),
          datetime: isoDate(note.dates.updated),
        },
      ]
    : []),
  ...DISPLAYED_FIELDS.flatMap((key) => {
    const value = format(note.frontmatter[key])
    return value ? [{ key, label: t(`note.field.${key}`), value }] : []
  }),
]

/**
 * The dates leave the search index; everything else stays in it.
 *
 * Both rows sit inside `data-pagefind-body`, so “Created Jan 12, 2026 Updated
 * Apr 8, 2026” led every excerpt for every note: forty characters of the one
 * thing nobody searches prose for. `aliases` is the reason this is a row-level
 * decision rather than a `<dl>`-level one: an alias is exactly what somebody
 * types when they cannot remember a note's real title, and dropping the whole
 * block would have made “Slipbox method” stop finding Zettelkasten.
 *
 * A date row is the one that carries a `datetime`, so the test is the data
 * rather than a second list to keep in step.
 */
const indexed = config.features.search ? '' : undefined
---

{
  rows.length > 0 && (
    <dl class="note-frontmatter">
      {rows.map((row) => (
        <div data-pagefind-ignore={row.datetime ? indexed : undefined}>
          <dt>{row.label}</dt>
          <dd>{row.datetime ? <time datetime={row.datetime}>{row.value}</time> : row.value}</dd>
        </div>
      ))}
    </dl>
  )
}
