---
/**
 * The outline.
 *
 * A `<details open>` rather than a bare list. In the rail its summary is the
 * "Contents" label, matching "Linked from" beneath it; stacked above the prose
 * the same element is a boxed, collapsible outline. One element, two
 * behaviours, no duplicate content for a screen reader to read twice, and
 * because the disclosure marker is suppressed either way, the label happens to
 * collapse rather than announcing itself as a control.
 */
import { t } from '../i18n/index.js'
import { outlineHeadings, type Heading } from '../lib/headings.js'

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const shown = outlineHeadings(headings)
---

{
  shown.length > 1 && (
    <details class="note-toc" open>
      <summary class="label">{t('note.contents')}</summary>
      <nav class="toc-list" aria-label={t('note.contents')}>
        {shown.map((heading) => (
          <a href={`#${heading.slug}`} data-depth={heading.depth}>
            {heading.text}
          </a>
        ))}
      </nav>
    </details>
  )
}
