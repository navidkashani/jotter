---
/**
 * One cell of the hairline grid: a title and enough of the note to decide.
 *
 * No date. A card is an invitation to read something, and the grid it sits in
 * is "start here" rather than "what changed" — the dated view is the row list.
 */
import type { VaultNote } from '../lib/vault.js'
import { noteHref } from '../lib/href.js'

interface Props {
  note: VaultNote
  showExcerpt?: boolean
}
const { note, showExcerpt = true } = Astro.props
---

<a class="note-card" href={noteHref(note.slug)}>
  <span class="note-card-title">{note.title}</span>
  {showExcerpt && note.excerpt && <span class="note-card-excerpt">{note.excerpt}</span>}
</a>
