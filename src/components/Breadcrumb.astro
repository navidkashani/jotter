---
/**
 * Where the note lives in the vault.
 *
 * Not a navigation aid so much as an orientation one: it says "this page is a
 * note, in a folder, in somebody's vault", which is the whole premise of a
 * published garden. The folder segments are links because every folder has a
 * real page; the last crumb is not, because you are already on it.
 *
 * Derived from `note.path` against the folder tree that `src/lib/tree.ts`
 * already computed for the sidebar, so it costs one array lookup per note, and
 * so the folder names here are the same ones the sidebar draws: on an Open
 * Publish build those come from `config.folderNames` rather than from the path,
 * which is a slug.
 *
 * The last crumb is the note's **title**, not `<filename>.md`. It used to be the
 * filename, which read well on a vault of ordinary markdown and read as a bug
 * on a published one: every note there is written to its slug, so the trail
 * ended `wisdom-approaches / nvc.md` under a heading that said "How to
 * Communicate". A title is what the note is called in both.
 */
import type { VaultNote } from '../lib/vault.js'
import { allFolders, config } from '../lib/site.js'
import { noteHref } from '../lib/href.js'

interface Props {
  note: VaultNote
}

const { note } = Astro.props

const segments = note.path.split('/').slice(0, -1)
const crumbs = segments
  .map((_, i) => allFolders.find((folder) => folder.path === segments.slice(0, i + 1).join('/')))
  .filter((folder) => folder !== undefined)

/**
 * Out of the search index. This sits at the top of the article, inside
 * `data-pagefind-body`, so without this every result's excerpt opened with a
 * file path (“Niklas Luhmann.md”) before a word of the note itself. The
 * folder names are also links to *other* pages, which is the same argument
 * `Note.astro` makes for the rail.
 */
const indexed = config.features.search ? '' : undefined
---

<p class="label note-crumb" data-pagefind-ignore={indexed}>
  {
    crumbs.map((folder) => (
      <>
        <a href={noteHref(folder.slug)}>{folder.name}</a>
        <span aria-hidden="true">/</span>
      </>
    ))
  }
  <span>{note.title}</span>
</p>
