---
import { tagHref } from '../lib/href.js'
import { config } from '../lib/site.js'
import { textDir } from '../lib/bidi.js'
import { t } from '../i18n/index.js'

interface Props {
  tags: string[]
}
const { tags } = Astro.props
---

{
  tags.length > 0 && (
    <ul class="tag-list" aria-label={t('note.tags')}>
      {tags.map((tag) => (
        <li>
          <a class="tag-chip" href={tagHref(tag)} dir={textDir(tag, config.dir)}>
            #{tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
