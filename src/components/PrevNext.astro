---
import type { VaultNote } from '../lib/vault.js'
import { config } from '../lib/site.js'
import { noteHref } from '../lib/href.js'
import { t } from '../i18n/index.js'

interface Props {
  previous?: VaultNote
  next?: VaultNote
}
const { previous, next } = Astro.props

/**
 * Belt and braces, and deliberately so. Pagefind skips `<nav>` by default, so
 * this attribute changes nothing today, but the default is a list of element
 * names in someone else's release, and the reason these two titles must stay
 * out of the index is jotter's: they belong to *other* notes, and indexed here
 * every note would match on both its neighbours' names. Saying it out loud
 * costs 22 bytes and survives a change of default.
 *
 * `<PrevNext>` sits inside `.note-body`, which is inside the article carrying
 * `data-pagefind-body`, so nothing above it excludes it. See `Note.astro`.
 */
const indexed = config.features.search ? '' : undefined
---

{
  (previous || next) && (
    <nav
      class="prev-next"
      aria-label={`${t('note.previous')} / ${t('note.next')}`}
      data-pagefind-ignore={indexed}
    >
      {previous && (
        <a class="previous" href={noteHref(previous.slug)} rel="prev">
          <span class="label">{t('note.previous')}</span>
          <span class="prev-next-title">{previous.title}</span>
        </a>
      )}
      {next && (
        <a class="next" href={noteHref(next.slug)} rel="next">
          <span class="label">{t('note.next')}</span>
          <span class="prev-next-title">{next.title}</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prev-next a {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .prev-next-title {
    font-size: var(--step-small);
    font-weight: var(--weight-medium);
    color: var(--ink-strong);
    line-height: 1.35;
  }

  .prev-next a:hover .prev-next-title {
    color: var(--accent-hover);
  }
</style>
