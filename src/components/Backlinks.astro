---
/**
 * What links here.
 *
 * One markup, two shapes. Below the prose (the `column` layout, and `panels`
 * once it folds) a backlink is a card with an excerpt, because at 660px it is a
 * real invitation to keep reading. In the 218px rail it tightens to a compact
 * bordered row and drops the excerpt — four words a line is not an excerpt.
 * That is done in CSS rather than with a prop, so the form follows the width
 * the reader actually has rather than the layout the config asked for.
 *
 * The section is rendered even when empty, with a line saying so. In a garden,
 * "nothing links here yet" is information — it is how you find the notes that
 * have not been woven in.
 */
import type { GraphLink } from '../lib/graph.js'
import { vault } from '../lib/site.js'
import { noteHref } from '../lib/href.js'
import { t } from '../i18n/index.js'

interface Props {
  links: GraphLink[]
}

const { links } = Astro.props

// `note.excerpt` is computed for every note during the vault scan, so the card
// form costs a map lookup rather than any extra work at build time.
const entries = links.map((link) => ({
  ...link,
  excerpt: vault.bySlug.get(link.slug)?.excerpt,
}))
---

<section class="rail-section" aria-labelledby="backlinks-heading">
  <h2 class="label rail-heading" id="backlinks-heading">{t('note.backlinks')}</h2>
  {
    entries.length > 0 ? (
      <div class="backlink-cards">
        {entries.map((entry) => (
          <a class="backlink-card" href={noteHref(entry.slug)}>
            <span class="backlink-card-title">{entry.title}</span>
            {entry.excerpt && <span class="backlink-card-excerpt">{entry.excerpt}</span>}
          </a>
        ))}
      </div>
    ) : (
      <p class="rail-empty">{t('note.noBacklinks')}</p>
    )
  }
</section>
