---
/**
 * What links here.
 *
 * The section is rendered even when empty, with a line saying so. In a garden,
 * "nothing links here yet" is information — it is how you find the notes that
 * have not been woven in.
 */
import type { GraphLink } from '../lib/graph.js'
import { noteHref } from '../lib/href.js'
import { t } from '../i18n/index.js'

interface Props {
  links: GraphLink[]
}

const { links } = Astro.props
---

<section class="rail-section" aria-labelledby="backlinks-heading">
  <h2 class="meta rail-heading" id="backlinks-heading">{t('note.backlinks')}</h2>
  {
    links.length > 0 ? (
      <div class="rail-links">
        {links.map((link) => (
          <a href={noteHref(link.slug)}>{link.title}</a>
        ))}
      </div>
    ) : (
      <p class="rail-empty">{t('note.noBacklinks')}</p>
    )
  }
</section>

<style>
  .rail-empty {
    font-size: var(--step-small);
    color: var(--ink-faint);
    line-height: 1.45;
  }
</style>
