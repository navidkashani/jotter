---
/**
 * The local graph.
 *
 * Two renderings of one neighbourhood, in DOM order: an empty mount carrying
 * the data, and the readable list of relationships underneath it — outgoing
 * above, incoming below.
 *
 * `src/scripts/local-graph.ts` inserts a canvas and an expand button into the
 * mount, appends the dialog that button opens to `<body>`, and makes the list
 * `.visually-hidden`. Not `display: none`: the list stays in the
 * accessibility tree, because a force-directed canvas is a picture and the
 * list is the only version of it a screen reader or a keyboard can use. With
 * scripting off nothing happens, no canvas appears, and the list is simply
 * visible. It is the fallback rather than a placeholder.
 *
 * The neighbourhood travels in a `data-` attribute rather than through
 * `define:vars`, which forces the script inline — and an inline script is
 * neither bundled nor shared between pages, which is most of the point of
 * spending 17 KB on `d3-force` once.
 *
 * When `features.graph` is false this component is never rendered at all, so
 * the markup, its styles and the script are absent rather than hidden.
 */
import type { Neighbourhood } from '../lib/graph.js'
import { noteHref } from '../lib/href.js'
import { t } from '../i18n/index.js'

interface Props {
  neighbourhood: Neighbourhood
  current: string
}

const { neighbourhood, current } = Astro.props

/**
 * Outgoing first. `neighbourhood()` happens to return them in that order
 * today, as a side effect of walking outgoing links before backlinks, but that
 * is a property of its traversal rather than a promise it makes — so the order
 * is taken from the edges here, where the claim is made.
 */
const linkedTo = new Set(
  neighbourhood.edges.filter((e) => e.source === current).map((e) => e.target),
)
const neighbours = neighbourhood.nodes
  .filter((n) => n.slug !== current)
  .sort((a, b) => Number(linkedTo.has(b.slug)) - Number(linkedTo.has(a.slug)))

/**
 * A mutual pair is two directed edges, and drawing both would put two lines on
 * the same pixels. Collapsing them here rather than in the browser keeps the
 * payload smaller and the client dumber.
 */
const seen = new Set<string>()
const links = neighbourhood.edges.filter(({ source, target }) => {
  const pair = [source, target].sort().join(' ')
  if (seen.has(pair)) return false
  seen.add(pair)
  return true
})

const data = {
  current,
  nodes: neighbourhood.nodes.map((n) => ({
    slug: n.slug,
    title: n.title,
    // Built here, so the client never has to know how a jotter URL is spelled.
    href: noteHref(n.slug),
  })),
  links,
  /**
   * The expand button and the dialog are built in the browser, so their labels
   * have to travel. Inside the payload rather than as two more attributes: the
   * channel already exists, and one `JSON.parse` is cheaper than three reads.
   */
  labels: { expand: t('note.expandGraph'), close: t('note.closeGraph') },
}
---

{
  neighbours.length > 0 && (
    <section class="rail-section" aria-labelledby="graph-heading">
      <h2 class="label rail-heading" id="graph-heading">
        {t('note.graph')}
      </h2>
      <div class="graph-canvas" data-graph={JSON.stringify(data)} />
      <div class="rail-links graph-list">
        {neighbours.map((node) => (
          <a href={noteHref(node.slug)}>{node.title}</a>
        ))}
      </div>
    </section>
  )
}

<script>
  import '../scripts/local-graph.js'
</script>

<style>
  .graph-list a::before {
    content: '';
    display: inline-block;
    inline-size: 5px;
    block-size: 5px;
    margin-inline-end: var(--space-3xs);
    border-radius: 50%;
    background: var(--rule-strong);
    vertical-align: middle;
  }

  .graph-list a:hover::before {
    background: var(--accent);
  }
</style>
