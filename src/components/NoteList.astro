---
/**
 * The two ways jotter lists notes: a grid of cards, or dense rows.
 *
 * Rows are the default for long lists — 200 cards is a wall, 200 rows is an
 * index you can scan.
 */
import type { VaultNote } from '../lib/vault.js'
import { noteHref } from '../lib/href.js'
import { formatDate, isoDate } from '../i18n/index.js'
import NoteCard from './NoteCard.astro'

interface Props {
  notes: VaultNote[]
  variant?: 'grid' | 'rows'
  showExcerpt?: boolean
}
const { notes, variant = 'rows', showExcerpt = true } = Astro.props
---

{
  variant === 'grid' ? (
    <div class="note-grid">
      {notes.map((note) => (
        <NoteCard note={note} showExcerpt={showExcerpt} />
      ))}
    </div>
  ) : (
    <div class="note-rows">
      {notes.map((note) => (
        <a class="note-row" href={noteHref(note.slug)}>
          <span class="note-row-title">{note.title}</span>
          <time class="meta note-row-date" datetime={isoDate(note.dates.updated)}>
            {formatDate(note.dates.updated)}
          </time>
        </a>
      ))}
    </div>
  )
}
