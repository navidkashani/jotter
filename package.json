{
  "name": "jotter",
  "version": "0.7.1",
  "private": true,
  "description": "An Astro theme for publishing an Obsidian vault, designed rather than merely generated.",
  "keywords": [
    "astro",
    "astro-theme",
    "obsidian",
    "digital-garden",
    "zettelkasten",
    "wikilinks",
    "static-site",
    "notes",
    "open-publish"
  ],
  "homepage": "https://github.com/navidkashani/jotter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidkashani/jotter.git"
  },
  "bugs": {
    "url": "https://github.com/navidkashani/jotter/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/fetch-content.mjs && astro build && node scripts/verify-build.mjs && node scripts/finalize.mjs",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "astro check",
    "verify": "node scripts/verify-build.mjs",
    "verify:full": "astro build && node scripts/verify-build.mjs && node scripts/verify-theme.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.3.8",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.2.7",
    "d3-force": "^3.0.0",
    "pagefind": "^1.5.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/d3-force": "^3.0.10",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
